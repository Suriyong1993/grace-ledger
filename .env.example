# Grace Ledger v2 — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT
JWT_SECRET=generate-a-random-64-character-string-here

# Database (for Drizzle ORM direct connection)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grace_ledger

# AI (optional)
FIREWORKS_API_KEY=your-fireworks-api-key
GEMINI_API_KEY=your-gemini-api-key

# LINE Messaging API (optional)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=