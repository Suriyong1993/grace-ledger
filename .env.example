# Grace Ledger — Supabase connection overrides
# Copy this to .env.staging and fill in your project's values.
# The app falls back to the hardcoded default (production) when these are
# not set, so only the staging server needs this file.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ---------------------------------------------------------------------------
# Operator scripts (scripts/*.mjs). Nothing privileged belongs in a committed
# file — scripts/supabase-credentials.mjs reads these and fails loudly when one
# is missing, and `npm run lint:secrets` rejects any literal that comes back.
#
# A service_role key BYPASSES ROW LEVEL SECURITY. Keep it out of the browser,
# out of git, and prefer an RPC or an Edge Function wherever one exists.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
GRACE_TEST_USER_PASSWORD=
GRACE_TEST_OPERATOR_EMAIL=
