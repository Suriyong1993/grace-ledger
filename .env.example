// .env.example — updated for Supabase + Vercel production setup
// Copy to .env.local for local development

// ============================================================================
// Supabase (Backend)
// ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

// ============================================================================
// App
// ============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

// ============================================================================
// Fireworks AI (Serverless LLM / Vision API)
// ============================================================================
FIREWORKS_API_KEY=fw_your-api-key-here

// ============================================================================
// Vercel Production (set in Vercel dashboard)
// Production values:
// VITE_SUPABASE_URL=https://your-project.supabase.co
// VITE_SUPABASE_ANON_KEY=pk.your-production-anon-key
// APP_URL=https://grace-ledger.vercel.app
// ============================================================================