# ============================================================================
# Grace Ledger v2 — Environment Variables
# ============================================================================
# Copy this file to .env and fill in ALL values.
# No defaults are provided in docker-compose.yml — every required variable
# must be set here or in your Portainer stack environment.

# Database connection string (must match POSTGRES_* variables below)
DATABASE_URL=postgres://grace_ledger:CHANGE_ME_STRONG_PASSWORD@postgres:5432/grace_ledger

# JWT signing secret — generate with: openssl rand -hex 64
# WARNING: Must be a strong random 64-char hex string in production
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Node environment
NODE_ENV=production

# Application port (inside container)
PORT=3000

# Public URL of this deployment (used for redirects, CORS, cookie scoping)
APP_URL=https://your-domain.example.com

# PostgreSQL superuser (for database creation via docker-compose)
POSTGRES_USER=grace_ledger
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=grace_ledger

# Logging level (silent | fatal | error | warn | info | debug | trace)
LOG_LEVEL=info