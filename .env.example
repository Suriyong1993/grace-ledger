# Grace Ledger v2 — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ============================================================================
# Supabase (Backend)
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# JWT
JWT_SECRET=generate-a-random-64-character-string-here

# Database (for Drizzle ORM direct connection)
DATABASE_URL=postgres://postgres:***@localhost:5432/grace_ledger

# ============================================================================
# OpenRouter API (LLM backend — optional, for AI features)
# Free model: inclusionai/ling-3.0-flash:free
# Premium model: moonshotai/kimi-k3 (1M ctx, fast)
# ============================================================================
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_SITE_URL=https://grace-ledger-pearl.vercel.app
OPENROUTER_APP_NAME=Grace Ledger

# AI (optional, legacy)
FIREWORKS_API_KEY=your-fireworks-api-key
GEMINI_API_KEY=your-gemini-api-key

# LINE Messaging API (optional)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ============================================================================
# Vercel Production (set in Vercel dashboard → Settings → Environment Variables)
# APP_URL=https://grace-ledger-pearl.vercel.app
# ============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
